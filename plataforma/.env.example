# =============================================================================
# Artes Polaroids — variáveis de ambiente
# Copie este arquivo para .env.local e preencha. NUNCA commite o .env.local.
# =============================================================================

# --- Supabase (supabase.com → seu projeto → Project Settings → API) ----------
# URL do projeto. Pública: pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "anon" / "publishable". Pública: tudo que ela acessa é limitado pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" / "secret". SECRETA: ignora o RLS. Só usada no servidor
# (checkout, webhook, admin). Nunca coloque NEXT_PUBLIC_ na frente dela.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (Fase 1 — Prompts 6 e 7) ---------------------------------
# Use as credenciais de TESTE até o fluxo inteiro funcionar.
# mercadopago.com.br/developers → Suas integrações → Credenciais
# Public Key. PUBLICA de proposito: o formulario de cartao no navegador usa
# ela para mandar o cartao direto ao Mercado Pago, sem passar por nos.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Access Token. SECRETO: cobra de verdade. Nunca com NEXT_PUBLIC_ na frente.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (Webhooks → Configurar notificações)
MERCADOPAGO_WEBHOOK_SECRET=

# --- Site ------------------------------------------------------------------
# URL pública do site (usada em links do WhatsApp, Open Graph, webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
